# =============================================
# Capacitor / Native platforms
# =============================================

# iOS native project is tracked (custom Info.plist/ATS), except generated parts
ios/App/Pods/
ios/App/App/public/
ios/DerivedData/

# electron/ — generated, not tracked
electron/

# Copied web assets inside the Android project (regenerated by `npx cap sync`)
android/app/src/main/assets/public/

# --- Android: keep source, ignore build artifacts ---
# (android/ source is hand-crafted, keep it for long-term development)
android/.gradle/
android/app/build/
android/build/
android/capacitor-cordova-android-plugins/
android/local.properties
android/*.apk
android/*.aab
android/.cxx/
*.jks
*.keystore

