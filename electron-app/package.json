{
  "name": "webssh-desktop",
  "version": "1.0.0",
  "description": "WebSSH Desktop Client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.webssh.desktop",
    "productName": "WebSSH",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../core",
        "to": "core",
        "filter": ["**/*", "!**/node_modules/**"]
      },
      {
        "from": "../dist",
        "to": "dist"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "icon.ico",
      "signDlls": false,
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "WebSSH-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "tree-kill": "^1.2.2"
  }
}
